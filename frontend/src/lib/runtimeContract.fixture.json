  "dashboard": {
    "initialTimeZoomLevel": 0,
    "keys": {
      "CLOSER": "z",
      "WIDER": "x",
      "RESET": "r",
      "VIEW": "v",
      "NEXT_WALLET_PAGE": "j",
      "PREVIOUS_WALLET_PAGE": "k"
    },
    "maxChartHistoryPoints": 720,
    "maxChartTokens": 20,
    "maxTimeZoomLevel": 3,
    "maxWalletTimelineEvents": 5000,
    "minTimeZoomLevel": -3,
    "timeZoomFactor": 2,
    "chartWindowPolicy": {
      "clampMaximum": true,
      "clampMinimum": true,
      "rounding": "floor"
    },
    "walletNotionalTierCount": 3,
    "firstWalletNotionalTier": 1,
    "nonpositiveMaxNotionalThreshold": "0",
    "walletNotionalTierDenominator": 3,
    "walletNotionalTierUpperNumerators": [
      1,
      2
    ],
    "walletBucketPolicy": {
      "clampToLastColumn": true,
      "rounding": "floor"
    },
    "walletBucketRounding": {
      "FLOOR": "floor"
    },
    "walletNotionalTierUpperBoundInclusive": true,
    "walletMarketLabelPolicy": {
      "ellipsis": "\u2026",
      "maximumTokenLength": 12,
      "partSeparator": " \u00b7 ",
      "prefixLength": 7,
      "suffixLength": 4
    }
  },
  "dispatchSkipReason": {
    "MARKET_METADATA_MISSING": "market_metadata_missing",
