    "accepted": {
      "execution": "none",
      "requiresRejectDetails": false
    },
    "filled": {
      "execution": "exact_request",
      "requiresRejectDetails": false
    },
    "partial": {
      "execution": "below_request",
      "requiresRejectDetails": false
    },
    "rejected": {
      "execution": "none",
      "requiresRejectDetails": true
    },
    "canceled": {
      "execution": "none",
      "requiresRejectDetails": false
    }
