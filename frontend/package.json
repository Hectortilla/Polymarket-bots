{
  "name": "polybot-control-plane-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate": "svelte-kit sync && openapi-ts",
    "generate:check": "npm run generate && git diff --exit-code -- src/lib/api/generated",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@xyflow/svelte": "1.6.2",
    "ajv": "8.20.0",
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "phosphor-svelte": "3.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.0.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
