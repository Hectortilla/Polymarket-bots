[Unit]
Description=Polybot release activation {{ release_tag }} {{ operation }}
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory={{ polybot_root }}/{{ deployment_contract.paths.releases }}/{{ release_tag }}
Environment=DOCKER_CONFIG={{ polybot_root }}/{{ deployment_contract.paths.registry }}
Environment=UV_NO_SYNC=1
ExecStart={{ polybot_root }}/{{ deployment_contract.paths.releases }}/{{ release_tag }}/.venv/bin/python -m scripts.beta_release --app-dir {{ polybot_root }} --bundle {{ polybot_root }}/{{ deployment_contract.paths.releases }}/{{ release_tag }} {{ '--rollback' if operation == 'rollback' else '' }}
ExecStopPost=/usr/bin/rm -f {{ polybot_root }}/{{ deployment_contract.paths.registry }}/config.json
TimeoutStartSec={{ deployment_contract.activation_timeout }}
UMask=0077
StandardOutput=journal
StandardError=journal
