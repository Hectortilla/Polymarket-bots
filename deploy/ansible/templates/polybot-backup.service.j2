[Unit]
Description=Polybot backup
After=docker.service tailscaled.service network-online.target
ConditionPathExists={{ polybot_root }}/current/.venv/bin/python
[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory={{ polybot_root }}/current
ExecStart={{ polybot_root }}/current/.venv/bin/python -m scripts.host_operations --root {{ polybot_root }} backup
UMask=0077
TimeoutStartSec={{ backup_policy.timeout }}
StandardOutput=journal
StandardError=journal
