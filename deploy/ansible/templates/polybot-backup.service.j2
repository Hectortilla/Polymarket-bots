[Unit]
Description=Polybot backup
After=docker.service tailscaled.service network-online.target
# Defer only until a release has been staged; a lost active runtime must fail.
ConditionPathExistsGlob={{ polybot_root }}/{{ deployment_contract.paths.releases }}/*/pyproject.toml
[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory={{ polybot_root }}/{{ deployment_contract.paths.current }}
ExecStart={{ polybot_root }}/{{ deployment_contract.paths.current }}/.venv/bin/python -m scripts.host_operations --root {{ polybot_root }} {{ deployment_contract.operations.backup }}
UMask=0077
TimeoutStartSec={{ deployment_contract.timeout }}
StandardOutput=journal
StandardError=journal
