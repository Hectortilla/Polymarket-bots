# Image values must be local sha256 IDs or registry references pinned by digest.
POLYBOT_BACKEND_IMAGE=sha256:REPLACE
POLYBOT_FRONTEND_IMAGE=sha256:REPLACE
POLYBOT_POSTGRES_IMAGE=postgres@sha256:REPLACE
POLYBOT_REDIS_IMAGE=redis@sha256:REPLACE
POLYBOT_RELEASE_ID=REPLACE_WITH_COMMIT
POLYBOT_AUTH_ORIGIN=https://localhost:8443
POLYBOT_HTTPS_PORT=8443
POLYBOT_SECRETS_DIR=/absolute/path/to/runtime-secrets

# SMTP submission requires TLS and runtime-only credentials.
POLYBOT_SMTP_HOST=smtp.example.com
POLYBOT_SMTP_PORT=587
POLYBOT_SMTP_SECURITY=starttls
POLYBOT_SMTP_FROM=accounts@example.com
